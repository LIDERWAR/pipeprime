# ================================================================
# PipePrime Caddyfile (Automatic HTTPS via Let's Encrypt / Zero-SSL)
# Replace pipeprime.ru with your actual production domain
# ================================================================

pipeprime.ru, www.pipeprime.ru {
    encode gzip zstd

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # Request limits (50MB for project blueprints upload)
    request_body {
        max_size 50MB
    }

    # Cache static assets
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=2592000, immutable"

    # Reverse proxy to FastAPI / Docker
    reverse_proxy 127.0.0.1:8000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
